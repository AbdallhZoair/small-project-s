def get_numbers():
    while True:
        try:
            num1 = float(input("Enter first number: "))
            num2 = float(input("Enter second number: "))
            return num1, num2
        except ValueError:
            print("Invalid input! Please enter numbers only.\n")
        except Exception as e:
            print(f"Unexpected error: {e}\n")

def addition(a, b):
    result = a + b
    print(result)
    return result
def subtraction(a, b):
    result = a - b
    print(result)
    return result
def multiplication(a, b):
    result = a * b
    print(result)
    return result
def power(a, b):
    result = a ** b
    print(result)
    return result
def division(a, b):
    
    try:
        result = a / b
        print(result)
        return result
    except ZeroDivisionError:
        print("Cannot divide by zero!")
        return "divide by zero!"
    except Exception as e:
        print(f"Unexpected error: {e}")
        return "Error"
def percentage(a, b):
    result = (a * b) / 100
    print("Result:", result)
    return result

